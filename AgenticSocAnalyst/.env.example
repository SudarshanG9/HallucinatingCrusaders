# ─────────────────────────────────────────────
# Agentic AI SOC Analyst — Environment Template
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# OpenAI / LLM
OPENAI_API_KEY=your_openai_api_key_here

# Wazuh
WAZUH_HOST=https://your-wazuh-host:55000
WAZUH_USER=your_wazuh_user
WAZUH_PASSWORD=your_wazuh_password

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_db
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=your_postgres_password

# Okta
OKTA_DOMAIN=your_okta_domain.okta.com
OKTA_API_TOKEN=your_okta_api_token
