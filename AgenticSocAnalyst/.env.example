# =============================================================================
# Agentic AI SOC Analyst — Environment Template
# Copy this file to .env and fill in your REAL values.
# NEVER commit the actual .env file (it is git-ignored).
# =============================================================================

# Vector Database (ChromaDB)
CHROMA_HOST=localhost
CHROMA_PORT=8001

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_analyst
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://soc_user:your_postgres_password_here@localhost:5432/soc_analyst
DATABASE_URL_SYNC=postgresql://soc_user:your_postgres_password_here@localhost:5432/soc_analyst

# LLM Config
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Okta API
OKTA_DOMAIN=your_company.okta.com
OKTA_API_TOKEN=your_okta_api_token_here

# Threat Intelligence APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
OTX_API_KEY=your_otx_api_key_here
